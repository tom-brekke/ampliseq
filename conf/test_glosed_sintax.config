/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for GloSED SINTAX smoke tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '2.h'
    ]
}

params {
    config_profile_name = 'Test GloSED SINTAX profile'
    config_profile_description = 'Minimal ITS test dataset to check pipeline function when using GloSED with SINTAX taxonomy assignment'

    FW_primer = "CTTGGTCATTTAGAGGAAGTAA"
    RV_primer = "TCCTGAGGGAAACTTCG"
    input = params.pipelines_testdata_base_path + "ampliseq/samplesheets/Samplesheet_pacbio_ITS.tsv"
    metadata = params.pipelines_testdata_base_path + "ampliseq/samplesheets/Metadata_pacbio_ITS.tsv"
    pacbio = true
    max_ee = 12
    cut_its = "its2"

    sintax_ref_taxonomy = "glosed"
    skip_dada_taxonomy = true

    min_samples = 2
    min_frequency = 10
    metadata_category_barplot = "var2,var3"
    tax_agglom_max = 4
    ancom = true
    sbdiexport = true
    qiime_adonis_formula = "var2"
    diversity_rarefaction_depth = 500
}